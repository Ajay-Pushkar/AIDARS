# Copy this file to deploy/.env and fill in real values. deploy/.env is
# never committed (see .gitignore) -- docker-compose.yml reads secrets
# from it via ${VAR} substitution; nothing in this repo embeds an actual
# credential.

# Comma-separated admin/client bearer tokens (see auth.py). Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AIDAR_ADMIN_TOKENS=changeme-generate-a-real-token

# Bootstrap/join secret every worker must present on registration.
AIDAR_WORKER_BOOTSTRAP_SECRET=changeme-generate-a-real-secret

# Leave at 0 (or unset) in any real deployment. Only ever "1" for local,
# throwaway, no-network-exposure experimentation -- see auth.py's
# module docstring and docs/M10_ARCHITECTURE.md's security section.
AIDAR_INSECURE_MODE=0
